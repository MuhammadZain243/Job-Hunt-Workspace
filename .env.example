# Platform bootstrap configuration only.
# Never store the owner's Gmail tokens, LinkedIn tokens, OpenAI API key,
# enrichment-provider keys, or CV contents in this file.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas or local MongoDB connection.
MONGODB_URI=mongodb://127.0.0.1:27017/job_hunt_workspace
MONGODB_DB_NAME=job_hunt_workspace

# Better Auth application secret (minimum 32 characters).
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Root key used to encrypt user-entered provider credentials in MongoDB.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: store in the hosting provider secret manager or KMS.
APP_ENCRYPTION_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
APP_ENCRYPTION_KEY_VERSION=1

# Inngest platform keys. Local development can use the Inngest dev server.
# Not required for Phase 0 runtime.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# CV storage bootstrap defaults.
# `local` is for development only. In production, connect Cloudinary or an
# S3-compatible provider from Settings. Provider credentials are encrypted in
# MongoDB and are intentionally not listed in this file.
CV_STORAGE_DEFAULT_PROVIDER=local
LOCAL_PRIVATE_STORAGE_PATH=.data/private-uploads

# Optional platform-managed S3-compatible fallback.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=job-hunt-private
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Optional observability.
SENTRY_DSN=
LOG_LEVEL=info

# Optional deployment-only security settings.
TRUSTED_PROXY_COUNT=1
